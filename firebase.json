{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "main",
      "public": "redesign-prototype",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "admin.html"],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**/*",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
            }
          ]
        }
      ],
      "rewrites": [
        { "source": "/", "destination": "/index.html" },
        { "source": "/movie", "destination": "/movie.html" },
        { "source": "/news", "destination": "/news.html" },
        { "source": "/about-us", "destination": "/about-us.html" }
      ]
    },
    {
      "target": "redesign",
      "public": "redesign-prototype",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "admin.html"],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**/*",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
            }
          ]
        }
      ],
      "rewrites": [
        { "source": "/", "destination": "/index.html" },
        { "source": "/movie", "destination": "/movie.html" },
        { "source": "/news", "destination": "/news.html" },
        { "source": "/about-us", "destination": "/about-us.html" }
      ]
    }
  ]
}
